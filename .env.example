APP_NAME="GitHub Doppelgänger Hunter API"
APP_VERSION="0.4-github"
DATABASE_URL="postgresql+psycopg://postgres:postgres@postgres:5432/doppel"
REDIS_URL="redis://redis:6379/0"
USE_REDIS_QUEUE=True
GITHUB_TOKEN=""
FETCH_TIMEOUT_SEC=12
MAX_FILES_PER_PROFILE=25
MAX_FILE_BYTES=120000
CODE_EXTENSIONS=".py,.js,.ts,.java,.go,.rs,.cpp,.c,.cs,.php,.rb,.swift,.kt,.scala,.sql,.html,.css,.md"
CACHE_HIT_THRESHOLD=1.0
SEARCH_FILES_LIMIT=15
SEARCH_LINES_PER_FILE=3
REPO_STRONG_THRESHOLD=60
REPO_COPY_THRESHOLD=80
